{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openagent-theme-garden",
  "version": "1.0.0",
  "description": "Garden: maia / olive / emerald / violet",
  "license": "MIT",
  "repository": "https://github.com/BANG404/openagent-theme-garden",
  "homepage": "https://ui.shadcn.com/create",
  "keywords": [
    "theme",
    "shadcn",
    "maia",
    "olive",
    "emerald"
  ],
  "extensions": {
    "openagent": {
      "type": "theme",
      "compatibility": {
        "plugin_protocol": {
          "min": 1,
          "max": 1
        },
        "features": [
          "theme-v1"
        ]
      },
      "theme": {
        "version": 1,
        "tokens": {
          "--font-sans": "'Figtree Variable', sans-serif",
          "--app-font-family": "var(--font-sans)",
          "--font-heading": "'Lora Variable', serif",
          "--radius": "0.875rem",
          "--app-font-size": "14px",
          "--settings-control-height": "38px",
          "--control-height": "38px",
          "--control-padding-inline": "18px",
          "--menu-item-min-height": "34px",
          "--menu-item-font-size": "13px",
          "--menu-item-padding-inline": "18px",
          "--settings-card-row-padding-block": "18px",
          "--plugin-card-padding": "18px",
          "--settings-content-padding": "36px"
        },
        "light": {
          "--background": "oklch(1 0 0)",
          "--foreground": "oklch(0.153 0.006 107.1)",
          "--card": "oklch(1 0 0)",
          "--card-foreground": "oklch(0.153 0.006 107.1)",
          "--popover": "oklch(1 0 0)",
          "--popover-foreground": "oklch(0.153 0.006 107.1)",
          "--primary": "oklch(0.508 0.118 165.612)",
          "--primary-foreground": "oklch(0.979 0.021 166.113)",
          "--secondary": "oklch(0.967 0.001 286.375)",
          "--secondary-foreground": "oklch(0.21 0.006 285.885)",
          "--muted": "oklch(0.966 0.005 106.5)",
          "--muted-foreground": "oklch(0.58 0.031 107.3)",
          "--accent": "oklch(0.508 0.118 165.612)",
          "--accent-foreground": "oklch(0.979 0.021 166.113)",
          "--destructive": "oklch(0.577 0.245 27.325)",
          "--border": "oklch(0.93 0.007 106.5)",
          "--input": "oklch(0.93 0.007 106.5)",
          "--ring": "oklch(0.737 0.021 106.9)",
          "--chart-1": "oklch(0.811 0.111 293.571)",
          "--chart-2": "oklch(0.606 0.25 292.717)",
          "--chart-3": "oklch(0.541 0.281 293.009)",
          "--chart-4": "oklch(0.491 0.27 292.581)",
          "--chart-5": "oklch(0.432 0.232 292.759)",
          "--sidebar": "oklch(0.988 0.003 106.5)",
          "--sidebar-foreground": "oklch(0.153 0.006 107.1)",
          "--sidebar-primary": "oklch(0.596 0.145 163.225)",
          "--sidebar-primary-foreground": "oklch(0.979 0.021 166.113)",
          "--sidebar-accent": "oklch(0.966 0.005 106.5)",
          "--sidebar-accent-foreground": "oklch(0.228 0.013 107.4)",
          "--sidebar-border": "oklch(0.93 0.007 106.5)",
          "--sidebar-ring": "oklch(0.737 0.021 106.9)",
          "--menu-surface": "var(--popover)",
          "--menu-foreground": "var(--popover-foreground)",
          "--menu-accent": "var(--primary)",
          "--menu-accent-foreground": "var(--primary-foreground)"
        },
        "dark": {
          "--background": "oklch(0.153 0.006 107.1)",
          "--foreground": "oklch(0.988 0.003 106.5)",
          "--card": "oklch(0.228 0.013 107.4)",
          "--card-foreground": "oklch(0.988 0.003 106.5)",
          "--popover": "oklch(0.228 0.013 107.4)",
          "--popover-foreground": "oklch(0.988 0.003 106.5)",
          "--primary": "oklch(0.432 0.095 166.913)",
          "--primary-foreground": "oklch(0.979 0.021 166.113)",
          "--secondary": "oklch(0.274 0.006 286.033)",
          "--secondary-foreground": "oklch(0.985 0 0)",
          "--muted": "oklch(0.286 0.016 107.4)",
          "--muted-foreground": "oklch(0.737 0.021 106.9)",
          "--accent": "oklch(0.432 0.095 166.913)",
          "--accent-foreground": "oklch(0.979 0.021 166.113)",
          "--destructive": "oklch(0.704 0.191 22.216)",
          "--border": "oklch(1 0 0 / 10%)",
          "--input": "oklch(1 0 0 / 15%)",
          "--ring": "oklch(0.58 0.031 107.3)",
          "--chart-1": "oklch(0.811 0.111 293.571)",
          "--chart-2": "oklch(0.606 0.25 292.717)",
          "--chart-3": "oklch(0.541 0.281 293.009)",
          "--chart-4": "oklch(0.491 0.27 292.581)",
          "--chart-5": "oklch(0.432 0.232 292.759)",
          "--sidebar": "oklch(0.228 0.013 107.4)",
          "--sidebar-foreground": "oklch(0.988 0.003 106.5)",
          "--sidebar-primary": "oklch(0.696 0.17 162.48)",
          "--sidebar-primary-foreground": "oklch(0.262 0.051 172.552)",
          "--sidebar-accent": "oklch(0.286 0.016 107.4)",
          "--sidebar-accent-foreground": "oklch(0.988 0.003 106.5)",
          "--sidebar-border": "oklch(1 0 0 / 10%)",
          "--sidebar-ring": "oklch(0.58 0.031 107.3)",
          "--menu-surface": "var(--popover)",
          "--menu-foreground": "var(--popover-foreground)",
          "--menu-accent": "var(--primary)",
          "--menu-accent-foreground": "var(--primary-foreground)"
        }
      },
      "i18n": {
        "supported_locales": [
          "en",
          "zh-CN"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "Garden",
            "description": "Garden: maia / olive / emerald / violet"
          },
          "zh-CN": {
            "display_name": "Garden",
            "description": "Garden 主题：maia / olive / emerald / violet"
          }
        }
      },
      "category": "design"
    }
  }
}
